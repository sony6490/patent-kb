# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# 本地生成的样例知识库（由 tests/make_sample_kb.py 生成）
tests/sample_kb/

# 索引库（运行时生成于知识库文件夹内）
.kbindex/

# 本地测试配置
tests/*_config.json
tests/boot.log

# 运维脚本的运行产物（日志 / 状态快照 / 文件清单 / 备份）
# 这些文件由本机扫描生成，含本地私有目录名与路径，不入库
scripts/*.log
scripts/*.mark
scripts/*.json
scripts/*.xlsx
scripts/*.bak-*
scripts/*.pid

# IDE/系统
.vscode/
.idea/
Thumbs.db
.DS_Store
